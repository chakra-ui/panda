{
  "name": "sandbox-codegen",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "test:up": "tsx ./cli.ts test -u",
    "test": "tsx ./cli.ts test && tsx ./cli.ts test -t",
    "codegen": "tsx ./cli.ts codegen",
    "dev": "pnpm codegen && vite",
    "build": "pnpm codegen && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.0",
    "@pandacss/cli": "workspace:*",
    "@pandacss/preset-base": "workspace:*",
    "@pandacss/preset-panda": "workspace:*",
    "@pandacss/vite": "workspace:*",
    "@preact/preset-vite": "2.10.6",
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/preact": "3.2.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/vue": "8.1.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "cac": "6.7.14",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "happy-dom": "20.14.0",
    "jsdom": "27.2.0",
    "preact": "10.29.8",
    "solid-js": "1.9.15",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vite-plugin-solid": "2.11.14",
    "vue": "3.5.42"
  }
}
