<article class="panel"></article>

<style lang="scss">
.panel {
  :global(> .item:not(.hidden)) {
    display: block;
  }

  :global(> li:has(> a)) {
    list-style: none;
  }

  :global(> .nav:not(.is-active):has(.icon)) {
    opacity: 1;
  }

  :global(> [data-state="(open)"]) {
    visibility: visible;
  }

  :global(> .a + .b) {
    margin-top: 1rem;
  }
}
</style>
