{
  "name": "playground",
  "version": "0.1.1-beta.13",
  "private": true,
  "scripts": {
    "css:codegen": "pnpm panda codegen --silent",
    "types:codegen": "tsx scripts/bundle-types.mts",
    "build": "pnpm db:generate && pnpm css:codegen && pnpm types:codegen && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "dev": "pnpm db:generate && pnpm css:codegen && next dev --webpack",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset",
    "viz": "ANALYZE=true next build --webpack",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ark-ui/react": "5.18.3",
    "@monaco-editor/react": "4.6.0",
    "@pandacss/compiler-shared": "2.0.0-beta.14",
    "@pandacss/compiler-wasm": "2.0.0-beta.14",
    "@pandacss/config": "beta",
    "@pandacss/preset-base": "beta",
    "@pandacss/preset-panda": "beta",
    "@prisma/client": "5.9.1",
    "@textea/json-viewer": "4.0.1",
    "lightningcss-wasm": "1.30.2",
    "merge-anything": "6.0.6",
    "monaco-editor": "0.46.0",
    "monaco-editor-auto-typings": "0.4.6",
    "monaco-jsx-syntax-highlight": "1.2.0",
    "nanoid": "5.1.6",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "os-browserify": "0.3.0",
    "outdent": "^0.8.0",
    "path-browserify": "1.0.1",
    "prism-react-renderer": "2.3.1",
    "prisma": "5.9.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-live-runner": "1.0.7",
    "sucrase": "3.35.0",
    "ts-pattern": "5.9.0",
    "typescript": "6.0.2",
    "usehooks-ts": "2.14.0",
    "util": "0.12.5",
    "zod": "3.25.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@next/bundle-analyzer": "16.3.0",
    "@pandacss/dev": "beta",
    "@pandacss/types": "beta",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "dts-bundle-generator": "9.5.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "raw-loader": "4.0.2",
    "tsx": "4.20.6"
  },
  "browserslist": [
    "Chrome 118"
  ]
}
