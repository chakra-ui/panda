generator client {
  provider = "prisma-client-js"
}

// ponytail: sqlite so the share API runs and is provable with zero external
// infra. Production swaps this to postgresql (env DATABASE_URL), matching the
// playground — the models below are provider-agnostic.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Phase 1: unlisted, view-only links. `code` is the deflate+base64url share
// blob (utils/share.ts) — self-contained token model + @layer tokens CSS.
// Versioning, edit-tokens, and visibility are the phase-2+ columns.
model Spec {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String?
  code      String
  createdAt DateTime @default(now())
}
