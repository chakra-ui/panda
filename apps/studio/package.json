{
  "name": "studio",
  "version": "2.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "deps:build": "pnpm --filter \"@pandacss/compiler-shared...\" build",
    "dev": "pnpm deps:build && nuxt prepare && panda codegen --log-level silent && nuxt dev",
    "build": "pnpm deps:build && nuxt prepare && panda codegen --log-level silent && nuxt build",
    "link": "vercel link --scope chakra-ui --project panda-studio-v2 --yes",
    "deploy": "vercel deploy --cwd ../.. --scope chakra-ui --project panda-studio-v2 --prod --yes",
    "deploy:preview": "vercel deploy --cwd ../.. --scope chakra-ui --project panda-studio-v2 --yes",
    "generate": "pnpm deps:build && panda codegen --log-level silent && nuxt generate",
    "sample": "panda codegen --cwd sample --spec --log-level warn && cp sample/styled-system/specs/design-system.json public/sample-design-system.json",
    "test": "vitest run",
    "spec-link": "tsx scripts/spec-link.ts"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.0.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@pandacss/compiler-shared": "workspace:*",
    "@pandacss/compiler-wasm": "2.1.1",
    "@pandacss/config": "2.1.1",
    "@pandacss/preset-base": "2.1.1",
    "@pandacss/preset-panda": "2.1.1",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "nuxt": "^3.13.0",
    "prettier": "3.2.5",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@pandacss/dev": "2.1.1",
    "@pandacss/postcss": "2.1.1",
    "@types/d3-array": "3.2.1",
    "@types/d3-scale": "4.0.9",
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.4.0",
    "vitest": "^2.1.0"
  }
}
